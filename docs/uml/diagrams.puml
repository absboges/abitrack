@startuml sequence_diagram
title АбиТрек — Sequence: Расчёт конкурсного балла через REST API

skinparam backgroundColor #0d0f14
skinparam SequenceBoxBackgroundColor #1c2030
skinparam SequenceBoxBorderColor #5b8fff
skinparam ArrowColor #5b8fff
skinparam FontColor #e8eaf0
skinparam ParticipantBackgroundColor #1c2030
skinparam ParticipantBorderColor #5b8fff

actor "Браузер (JS)" as JS
participant "Flask REST API\n/api/v1/calculate" as API
participant "ScoreCalculator\n(Context)" as Calc
participant "StandardScoreStrategy" as Strat
participant "БД\n(SQLite)" as DB

JS -> API : POST /api/v1/calculate\n{program_id: 1, individual_score: 5}
API -> DB : ExamResult.query.filter_by(user_id=...)
DB --> API : [Математика:85, Информатика:90, Русский:78]
API -> DB : Program.query.get(1)
DB --> API : Program(min_score=220, subjects=[...])
API -> Calc : calculate_for_program(results, subjects, 5, 220)
Calc -> Strat : calculate(results, subjects, 5, 220)
note right of Strat: Stotal = Σ Ei + Bind\n= (85+90+78) + 5 = 258
Strat --> Calc : ScoreResult(total=258, can_apply=True, gap=+38)
Calc --> API : ScoreResult
API --> JS : 200 OK\n{"ok":true,"data":{"total_score":258,"can_apply":true}}
JS -> JS : Обновить DOM (score, цвет кнопки)

@enduml
