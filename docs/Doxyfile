# Конфигурация Doxygen для проекта АбиТрек
# Генерация документации: doxygen docs/Doxyfile

PROJECT_NAME           = "АбиТрек — Информационная система абитуриента"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Веб-приложение с калькулятором ЕГЭ и отслеживанием сроков"

OUTPUT_DIRECTORY       = docs/generated
CREATE_SUBDIRS         = NO

# Входные файлы Python
INPUT                  = app/ config.py factory.py seed.py
FILE_PATTERNS          = *.py
RECURSIVE              = YES
EXCLUDE                = __pycache__ .venv venv

# Извлечение Python docstrings
OPTIMIZE_OUTPUT_JAVA   = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# Генерация HTML и LaTeX
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html

GENERATE_LATEX         = NO

# Диаграммы (если установлен graphviz)
HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

# Формат исходников
INPUT_ENCODING         = UTF-8
EXTENSION_MAPPING      = py=Python
PYTHON_DOCSTRING       = YES
